{
  "expo": {
    "name": "DuePlanner",
    "slug": "dueplanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dueplanner",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "bundleIdentifier": "com.duestudios.dueplanner",
      "supportsTablet": true
    },
    "android": {
      "package": "com.duestudios.dueplanner"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
