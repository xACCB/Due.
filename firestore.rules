rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Beyond "is this the right user", validate the actual shape of a write.
    // Auth alone only stops other people from touching your data -- this is
    // a second layer that stops a buggy client update (or someone editing
    // requests by hand with valid credentials, since firebaseConfig is
    // public by design) from writing garbage into your own document: wrong
    // field types, or unbounded strings run up your storage/bandwidth costs.
    // Optional fields are only type-checked when present, since profile
    // writes use merge:true and may only touch a subset of fields.
    // Size caps: every string, list and map a client can grow is bounded, so
    // a document can't be inflated toward Firestore's 1 MiB limit or run up
    // storage costs. The app stays inside the same numbers (src/lib/limits.ts)
    // so a normal edit never trips them -- change both together. Rules can't
    // look inside list items, so item contents are bounded only by the list
    // length and the 1 MiB document limit.
    // Every item of a list is text. Rules have no loops and can't look at each
    // item, but joining the items with a line break and splitting the result
    // again only gives back the same list if each one was text to begin with
    // (a number or true comes back as "5" or "true", which isn't equal; a map
    // or list can't be joined at all). So an item also can't contain a line
    // break; the app's one-line fields can't produce one, and what it imports
    // has them removed (sanitizeTask, withImportedSubjects).
    function allText(l) { return l.size() == 0 || l.join('\n').split('\n') == l; }

    function isValidProfile(data) {
      return data.keys().size() <= 40
        && (!('layout' in data) || (data.layout is string && data.layout.size() <= 40))
        && (!('colorCodeUrgency' in data) || data.colorCodeUrgency is bool)
        && (!('subjects' in data) || (data.subjects is list && data.subjects.size() <= 200
              // Rules can't look at each item, but joining them bounds the total
              // text: 200 subjects of at most 200 characters. (It can't check
              // that every item is text: join() also accepts numbers.)
              && data.subjects.join('').size() <= 40000
              // Subject names are text (added 2026-10-11): a number among them
              // would reach every device as a subject. A list left exactly as
              // it was is accepted as it is.
              && (allText(data.subjects) || (resource != null && 'subjects' in resource.data && resource.data.subjects == data.subjects))))
        && (!('subjectColors' in data) || (data.subjectColors is map && data.subjectColors.size() <= 200
              && data.subjectColors.keys().join('').size() <= 40000
              && data.subjectColors.values().join('').size() <= 6400))
        && (!('timeFormat' in data) || data.timeFormat in ['12h','24h'])
        && (!('weekStart' in data) || data.weekStart in [0,1]);
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id','title','subject','dueDate','dueTime','estMins','done','order'])
        // Room for today's ~18 fields plus a few future/legacy ones, without
        // allowing a doc to be padded out with arbitrary extra fields.
        && data.keys().size() <= 24
        && data.id is number
        && data.title is string && data.title.size() <= 500
        && data.subject is string && data.subject.size() <= 200
        && data.dueDate is string && data.dueDate.size() <= 10
        && data.dueTime is string && data.dueTime.size() <= 5
        && data.estMins is number && data.estMins >= 0 && data.estMins <= 100000
        && data.done is bool
        && data.order is number
        && (!('subtasks' in data) || (data.subtasks is list && data.subtasks.size() <= 100))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 30))
        && (!('sessions' in data) || (data.sessions is list && data.sessions.size() <= 1000))
        && (!('recurrence' in data) || data.recurrence == null || data.recurrence in ['none','daily','weekly','monthly'])
        && (!('priorityOverride' in data) || data.priorityOverride == null || data.priorityOverride in ['high','medium','low'])
        && (!('archived' in data) || data.archived is bool)
        && (!('completedAt' in data) || data.completedAt == null || data.completedAt is number)
        && (!('spawnedNextId' in data) || data.spawnedNextId == null || data.spawnedNextId is number)
        // Sync metadata (see src/lib/sync.ts): when the edit happened.
        && (!('updatedAt' in data) || data.updatedAt is number);
    }

    // ---- Stricter task checks (added 2026-10-10). isValidTask() above is checked
    // on every write, against the whole document as it will be stored. These
    // go further, and are split in two so that tightening them can never lock
    // anyone out of a task they already have:
    // - a NEW document (isTightTask) must pass all of them;
    // - an UPDATE (keepsOrTightens) must pass each one only for a field that
    //   the write actually changes. A field left as it was is left alone, even
    //   if an old version of the app, or an old import, stored something that
    //   wouldn't be accepted today.
    function validDueDate(v) { return v.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$'); }
    function validDueTime(v) { return v.matches('^([0-9]{2}:[0-9]{2})?$'); }
    // 30 tags of at most 100 characters each (src/lib/limits.ts).
    function tagsBounded(data) { return !('tags' in data) || data.tags.join('').size() <= 3000; }
    // Every tag is text (added 2026-10-11). join() above also accepts numbers
    // and the like, so that alone doesn't say so; see allText().
    function tagsAreText(data) { return !('tags' in data) || allText(data.tags); }
    // Timestamps come from the device's clock, and sync keeps the newest edit,
    // so a time from the far future would win every conflict forever. Two days
    // of slack, not minutes: a device whose clock or time zone is set wrong is
    // common, and must still be able to sync.
    function notFarFuture(ms) { return ms <= request.time.toMillis() + 172800000; }
    function timesNotFarFuture(data) {
      return (!('updatedAt' in data) || notFarFuture(data.updatedAt))
        && (!('completedAt' in data) || data.completedAt == null || notFarFuture(data.completedAt));
    }
    function isTightTask(data, taskId) {
      // The id inside the task is the document's name (the app writes
      // String(task.id)), so a task can't be stored under another's name.
      return string(data.id) == taskId
        && validDueDate(data.dueDate) && validDueTime(data.dueTime)
        && data.estMins is int
        && tagsBounded(data) && tagsAreText(data)
        && timesNotFarFuture(data);
    }
    function keepsOrTightens(data, old) {
      return data.id == old.id
        && (data.dueDate == old.dueDate || validDueDate(data.dueDate))
        && (data.dueTime == old.dueTime || validDueTime(data.dueTime))
        && (data.estMins == old.estMins || data.estMins is int)
        && (!('tags' in data) || ('tags' in old && data.tags == old.tags) || (tagsBounded(data) && tagsAreText(data)))
        && (!('updatedAt' in data) || ('updatedAt' in old && data.updatedAt == old.updatedAt) || notFarFuture(data.updatedAt))
        && (!('completedAt' in data) || data.completedAt == null || ('completedAt' in old && data.completedAt == old.completedAt) || notFarFuture(data.completedAt));
    }

    // ---- Task counter: a cap on how many tasks (and trash entries) one
    // account can hold. Rules can't count a collection, so users/{uid}/meta/
    // counts keeps the numbers: n = docs in tasks/, t = docs in trash/, last =
    // the task id the latest change was about. Every batch that creates,
    // deletes or moves a task also increments/decrements it, and the rules
    // below check the change matches which docs really exist before and after
    // that batch -- so the count can't be edited to anything but the truth.
    // (Client side: countDelta() in src/lib/sync.ts.)
    //
    // Deleting is never blocked (so nobody can get locked out of cleaning
    // up); only creating a task/trash doc requires the count. The counts doc
    // can't be deleted, or deleting and recreating it at zero would reset the
    // cap -- after an account is deleted it stays behind holding only numbers.
    //
    // Rollout: enforceTaskCap() was false (phase A) while app versions that
    // didn't write the counter could still be open; it's true since 2026-09-22
    // (phase B). Setting it back to false is the escape hatch if creates ever
    // start failing for a reason the counter gets wrong.
    function enforceTaskCap() { return true; }

    function countsPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/meta/counts;
    }
    function inColl(userId, coll, id, after) {
      return after
        ? existsAfter(/databases/$(database)/documents/users/$(userId)/$(coll)/$(id))
        : exists(/databases/$(database)/documents/users/$(userId)/$(coll)/$(id));
    }
    function isValidCountChange(userId) {
      let b = resource.data;
      let a = request.resource.data;
      let dn = a.n - b.n;
      let dt = a.t - b.t;
      return a.keys().hasOnly(['n','t','last'])
        && a.n is int && a.t is int
        // A task id as text: what String(number) can produce, nothing else.
        && a.last is string && a.last.size() > 0 && a.last.size() <= 30 && a.last.matches('^[0-9eE.+-]+$')
        && (dn != 0 || dt != 0)
        && dn == (inColl(userId, 'tasks', a.last, true) ? 1 : 0) - (inColl(userId, 'tasks', a.last, false) ? 1 : 0)
        && dt == (inColl(userId, 'trash', a.last, true) ? 1 : 0) - (inColl(userId, 'trash', a.last, false) ? 1 : 0)
        // The caps: 5000 tasks, 500 in the trash (the app keeps 200 at most).
        // Only checked when a number goes up, so being over never blocks a delete.
        && (dn <= 0 || a.n <= 5000)
        && (dt <= 0 || a.t <= 500);
    }
    // Creating a task/trash doc must bump the matching count in the same batch.
    function isCountedCreate(userId, taskId, field) {
      let c = countsPath(userId);
      return !enforceTaskCap()
        || (getAfter(c).data.last == taskId && getAfter(c).data[field] == get(c).data[field] + 1);
    }

    // A task in Recently deleted: the whole task, plus when it was deleted.
    function isValidTrashedTask(data) {
      return isValidTask(data) && data.deletedAt is number;
    }

    // The device list (Profile -> Devices): the devices signed in to this
    // account, as one map: { d: { deviceId: { name, createdAt, lastSeen } } }.
    // One map in one doc, not a doc per device, so its size can be capped here
    // (rules can't count a collection). Rules can't look inside each entry
    // either, so entries are bounded only by the count and the 1 MiB document
    // limit, like subjectColors. Removing a device's entry is how it gets
    // signed out (client side: src/lib/devices.ts). Nothing else in these
    // rules depends on this doc.
    //
    // Added 2026-10-11: a device id is 24 hex characters (newDeviceId()).
    // Either every id in the list is one, or the write adds no id (it only
    // refreshes or removes), so a list that already held something else can
    // still be used and put right. What an entry holds is not checked: rules
    // have no loops, and checking each of 20 entries by position costs more
    // than the 1,000 expressions one request may evaluate.
    // `old` is the map stored before this write ({} when there was no doc).
    function isValidDevices(data, old) {
      return data.keys().hasOnly(['d']) && data.d is map && data.d.size() <= 20
        // Device ids are 24 characters; this bounds what the map's keys can hold.
        && data.d.keys().join('').size() <= 1280
        && (data.d.size() == 0 || data.d.keys().join(',').matches('^[0-9a-f]{24}(,[0-9a-f]{24})*$')
              || data.d.diff(old).addedKeys().size() == 0);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfile(request.resource.data);

      match /tasks/{taskId} {
        allow read, delete: if isOwner(userId);
        allow update: if isOwner(userId) && isValidTask(request.resource.data) && keepsOrTightens(request.resource.data, resource.data);
        allow create: if isOwner(userId) && isValidTask(request.resource.data) && isTightTask(request.resource.data, taskId) && isCountedCreate(userId, taskId, 'n');
      }

      match /trash/{taskId} {
        allow read, delete: if isOwner(userId);
        allow update: if isOwner(userId) && isValidTrashedTask(request.resource.data) && keepsOrTightens(request.resource.data, resource.data)
          && (request.resource.data.deletedAt == resource.data.deletedAt || notFarFuture(request.resource.data.deletedAt));
        allow create: if isOwner(userId) && isValidTrashedTask(request.resource.data) && isTightTask(request.resource.data, taskId)
          && notFarFuture(request.resource.data.deletedAt) && isCountedCreate(userId, taskId, 't');
      }

      match /meta/counts {
        allow read: if isOwner(userId);
        // Starts at zero; tasks that already existed before the counter was
        // added just aren't counted (the cap is effectively that much higher).
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['n','t','last'])
          && request.resource.data.n == 0 && request.resource.data.t == 0
          && request.resource.data.last is string && request.resource.data.last.size() <= 30;
        allow update: if isOwner(userId) && isValidCountChange(userId);
        allow delete: if false;
      }

      match /meta/devices {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDevices(request.resource.data, resource == null ? {} : resource.data.d);
      }
    }

    // Deny everything else by default (Firestore already denies unmatched
    // paths, but explicit beats implicit for a security boundary).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
