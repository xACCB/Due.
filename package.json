{
  "name": "dueplanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dueplanner/web",
    "build": "tsc -p packages/core && npm run build -w @dueplanner/web",
    "lint": "eslint .",
    "preview": "npm run preview -w @dueplanner/web",
    "test": "vitest run",
    "test:rules": "npx firebase-tools emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:stress": "npx firebase-tools emulators:exec --only firestore \"vitest run --config vitest.stress.config.ts\"",
    "test:e2e": "npx firebase-tools emulators:exec --only auth,firestore \"node tests/e2e/run.mjs\"",
    "rules:rollback": "node scripts/rules-rollback.mjs",
    "audit:contrast": "node --experimental-strip-types scripts/check-theme-contrast.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^5.0.1",
    "firebase": "^12.13.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  }
}
